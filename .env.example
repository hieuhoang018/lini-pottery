# Compose/build-time only. App runtime config still lives in server/.env and client/.env.
VITE_API_URL=/api

# Only used if you run: docker compose --profile local-db up
POSTGRES_USER=lini
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lini

# Set to true to auto-seed test data (categories, products, an admin user, a customer
# user) into the server container's database on every `docker compose up`. Safe to
# re-run — the seed upserts rather than duplicating rows. See README's Docker section.
SEED_DB=false

# Only used if you run: docker compose --profile observability up
# Local-only Grafana admin login — see observability/README.md.
GF_SECURITY_ADMIN_PASSWORD=change-me
